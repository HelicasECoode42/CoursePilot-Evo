{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coursepilot.local/schemas/course-offering-snapshot-v1.json",
  "title": "CourseOfferingSnapshot v1 (planned)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "term", "offerings"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "pageOrigin", "capturedAt", "adapterVersion"],
      "properties": {
        "kind": {"const": "BROWSER_SNAPSHOT"},
        "pageOrigin": {"const": "https://jwxt.shu.edu.cn"},
        "capturedAt": {"type": "string", "format": "date-time"},
        "adapterVersion": {"type": "string", "minLength": 1}
      }
    },
    "term": {
      "type": "object", "additionalProperties": false,
      "required": ["xnm", "xqm"],
      "properties": {
        "xnm": {"type": "string", "minLength": 1},
        "xqm": {"type": "string", "minLength": 1}
      }
    },
    "offerings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["courseCode", "classId", "credits", "capacity", "teacherText", "meetingTextRaw", "meetings", "parseStatus", "sourceEndpoint"],
        "properties": {
          "courseCode": {"type": "string", "minLength": 1},
          "classId": {"type": "string", "minLength": 1},
          "credits": {"type": ["number", "null"], "minimum": 0},
          "capacity": {"type": ["integer", "null"], "minimum": 0},
          "teacherText": {"type": ["string", "null"]},
          "meetingTextRaw": {"type": "string"},
          "meetings": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["dayOfWeek", "sectionStart", "sectionEnd", "weeks"],
              "properties": {
                "dayOfWeek": {"type": "integer", "minimum": 1, "maximum": 7},
                "sectionStart": {"type": "integer", "minimum": 1},
                "sectionEnd": {"type": "integer", "minimum": 1},
                "weeks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
              }
            }
          },
          "parseStatus": {"enum": ["PARSED", "UNKNOWN_TIME_FORMAT", "NO_TIME"]},
          "sourceEndpoint": {"enum": ["zzxkyzb_cxZzxkYzbChoosedDisplay", "zzxkyzbjk_cxJxbWithKchZzxkYzb"]}
        }
      }
    }
  }
}
