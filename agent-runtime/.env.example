# Placeholder only; never commit real secrets (docs/16-engineering-and-debugging.md).
# The service fails fast on missing critical config; loopback defaults below are
# for local skeleton runs, not for any public deployment.

# Java tool API (module B). Empty -> tools report TOOL_UNAVAILABLE (503).
CP_JAVA_BASE_URL=
CP_SERVICE_KEY=

# OpenAI-compatible chat endpoint. Empty key -> FakeModelAdapter.
# Example: CP_MODEL_BASE_URL=https://api.deepseek.com
#          CP_MODEL_ID=deepseek-chat
# Put the real key only in local .env, never commit it.
CP_MODEL_BASE_URL=
CP_MODEL_API_KEY=
CP_MODEL_ID=DEPLOYMENT_MODEL_PLACEHOLDER
CP_TEMPERATURE=0.0

# Local W2 demo only. true -> TypedFakeToolClient. Never a real Java verifier.
CP_USE_FAKE_TOOLS=false

# Session and CORS.
CP_SESSION_TTL_SECONDS=1800
CP_CORS_ORIGINS=http://127.0.0.1:5173

# Harness whitelist directory (relative to the agent-runtime module root).
CP_HARNESS_DIR=harness
