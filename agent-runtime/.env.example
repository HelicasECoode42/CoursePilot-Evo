# Placeholder only; never commit real secrets (docs/16-engineering-and-debugging.md).
# Loopback defaults below are for local runs, not for any public deployment.
# Missing Java URL fails at request time with 503. Missing model key uses the
# fake model and marks the answer. A configured URL+key with the placeholder
# model id fails at startup.

# Java tool API (module B). Empty -> tools report TOOL_UNAVAILABLE (503).
CP_JAVA_BASE_URL=
CP_SERVICE_KEY=

# OpenAI-compatible chat endpoint. Empty key -> FakeModelAdapter (FAKE_MODEL).
# Example: CP_MODEL_BASE_URL=https://api.deepseek.com
#          CP_MODEL_ID=deepseek-chat
# Put the real key only in local .env, never commit it.
# If URL and key are both set, replace the placeholder before starting.
CP_MODEL_BASE_URL=
CP_MODEL_API_KEY=
CP_MODEL_ID=DEPLOYMENT_MODEL_PLACEHOLDER
CP_TEMPERATURE=0.0

# Local W2 demo only. true -> TypedFakeToolClient. Never a real Java verifier.
CP_USE_FAKE_TOOLS=false

# Session and CORS.
CP_SESSION_TTL_SECONDS=1800
CP_CORS_ORIGINS=http://127.0.0.1:5173

# Harness whitelist directory (relative to the agent-runtime module root).
CP_HARNESS_DIR=harness

# Optional budget overrides. Omit them to keep docs/04 defaults:
# 8000 input tokens, 2000 output tokens, 6 tool calls, 3 model calls, 45000 ms.
# CP_MAX_INPUT_TOKENS=8000
# CP_MAX_OUTPUT_TOKENS=2000
# CP_MAX_TOOL_CALLS=6
# CP_MAX_MODEL_CALLS=3
# CP_DEADLINE_MS=45000

# Per-session cumulative caps. The budget above is per run: BudgetTracker is built
# inside PlanningRunner.run and thrown away when the run ends, so resubmitting with a
# new Idempotency-Key starts from zero. These cap what one session can spend in total.
# Defaults are 5x the per-run budget, i.e. roughly five full planning runs per session.
# max_tracked_sessions also bounds the ledger: anonymous session creation is not rate
# limited, so the map would otherwise grow with the session count.
# CP_SESSION_MAX_INPUT_TOKENS=40000
# CP_SESSION_MAX_OUTPUT_TOKENS=10000
# CP_MAX_TRACKED_SESSIONS=10000
