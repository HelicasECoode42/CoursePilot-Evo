{
  "name": "coursepilot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:fixture": "vite --mode fixture --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint . && prettier --check src index.html *.json *.js *.ts",
    "typecheck": "vue-tsc --noEmit",
    "test:demo": "node --test ../demo/coursepilot-guided-demo.test.mjs",
    "check:demo-html": "python3 ../demo/check_html.py",
    "test:unit": "vitest run && npm run test:demo && npm run check:demo-html"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "pinia": "3.0.3",
    "vue": "3.5.22",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@types/node": "24.6.2",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.37.0",
    "eslint-plugin-vue": "10.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "vue-tsc": "3.0.8"
  }
}
