# D2 统一配置入口 · 模板（入库，只有占位值）
# 真实配置放 data/private/stack.env（已被 .gitignore 覆盖），或用环境变量覆盖。
# 键名与模块 C 的 agent-runtime/.env.example 对齐（CP_ 前缀），全组读同一份。
# 规则：docs/16（唯一配置入口、缺必要配置即失败）、docs/03（默认端口）、docs/04（密钥只在环境变量、CORS 不能用通配）

# --- MySQL（模块 B 的存储层）---
CP_MYSQL_HOST=127.0.0.1
CP_MYSQL_PORT=3306
CP_MYSQL_DB=
CP_MYSQL_USER=
CP_MYSQL_PASSWORD=

# --- Java 事实 API（模块 B）---
CP_JAVA_BASE_URL=http://127.0.0.1:8080
CP_SERVICE_KEY=

# --- Python 网关（模块 C）---
CP_API_BASE_URL=http://127.0.0.1:8000
CP_MODEL_BASE_URL=
CP_MODEL_API_KEY=

# --- Web（模块 E）---
CP_WEB_BASE_URL=http://127.0.0.1:5173
CP_CORS_ORIGINS=http://127.0.0.1:5173

# --- 等待与超时 ---
CP_HEALTH_TIMEOUT_SECONDS=60
CP_HEALTH_POLL_SECONDS=2
CP_START_COMMAND_TIMEOUT_SECONDS=180

